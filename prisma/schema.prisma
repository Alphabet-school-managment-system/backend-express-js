generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("PRISMA_DATABASE_URL")
}

model academicyear {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  branch_id        String    @db.Uuid
  name             String    @db.VarChar(100)
  name_local       String    @db.VarChar(100)
  start_date       DateTime  @db.Date
  end_date         DateTime  @db.Date
  enrollment_start DateTime  @db.Date
  enrollment_end   DateTime  @db.Date
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)

  branch        branch         @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  enrollment    enrollment[]
  expense       expense[]
  fees          fee[]
  timetables    timetable[]
  attendances   attendance[]
  behaviors     behavior[]
  leaverequests leaverequest[]
}

model assessment {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  title      String    @db.VarChar(100)
  term       String    @db.VarChar(100)
  subject    String    @db.VarChar(100)
  max_score  Int
  note       String?   @db.VarChar(250)
  teacher_id String?   @db.Uuid
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  teacher    teacher?  @relation(fields: [teacher_id], references: [id], onUpdate: NoAction, onDelete: SetNull)
  mark       mark[]
}

model attendance {
  id               String                 @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  academic_year_id String                 @db.Uuid
  term             String                 @db.VarChar(100)
  class            String                 @db.VarChar(100)
  section          String                 @db.VarChar(100)
  student_id       String                 @db.Uuid
  date             DateTime               @db.Date
  created_at       DateTime?              @default(now()) @db.Timestamp(6)
  updated_at       DateTime?              @default(now()) @db.Timestamp(6)
  status           attendance_status_enum
  enrollment       enrollment             @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  academicyear     academicyear           @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model behavior {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  academic_year_id String             @db.Uuid
  term             String             @db.VarChar(100)
  student_id       String             @db.Uuid
  date             DateTime           @db.Date
  description      String?
  type             behavior_type_enum
  enrollment       enrollment         @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  academicyear     academicyear       @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  branch           branch?            @relation(fields: [branchId], references: [id])
  branchId         String?            @db.Uuid
}

model branch {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  school_id       String            @db.Uuid
  name            String            @db.VarChar(100)
  location        String?           @db.VarChar(255)
  isCurrent       Boolean           @default(false) @db.Boolean
  isDefault       Boolean           @default(false) @db.Boolean
  academicyear    academicyear[]
  school          school            @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  libraryitem     libraryitem[]
  parent          parent[]
  staff           staff[]
  student         student[]
  teacher         teacher[]
  behavior        behavior[]
  libraryItemLoan libraryitemloan[]
}

model enrollment {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  academic_year_id String            @db.Uuid
  student_id       String            @db.Uuid
  grade            Int               @db.Integer
  section          String?           @db.VarChar(100)
  isTransferred    Boolean?          @default(false) @db.Boolean
  transferredFrom  String?           @db.VarChar(100)
  note             String?           @db.VarChar(255)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @default(now()) @db.Timestamp(6)
  attendance       attendance[]
  behavior         behavior[]
  academicyear     academicyear      @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  student          student           @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fee              fee[]
  libraryitemloan  libraryitemloan[]
  mark             mark[]
}

model expense {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  academic_year_id String            @db.Uuid
  title            String
  description      String?
  type             expense_type_enum
  other_type       String?           @db.VarChar(255)
  amount           Decimal           @db.Decimal(10, 2)
  date             DateTime          @db.Date
  receipt          String?           @db.VarChar(255)
  created_at       DateTime?         @default(now()) @db.Timestamp(6)
  updated_at       DateTime?         @default(now()) @db.Timestamp(6)
  academicyear     academicyear      @relation(fields: [academic_year_id], references: [id], onDelete: SetNull, onUpdate: NoAction)
}

model fee {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  academic_year_id String          @db.Uuid
  student_id       String          @db.Uuid
  amount           Decimal         @db.Decimal(10, 2)
  due_date         DateTime?       @db.Date
  status           fee_status_enum
  type             fee_type_enum
  other_type       String?         @db.VarChar(255)
  receipt          String?         @db.VarChar(255)
  note             String?
  created_at       DateTime?       @default(now()) @db.Timestamp(6)
  updated_at       DateTime?       @default(now()) @db.Timestamp(6)
  enrollment       enrollment      @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  academicyear     academicyear    @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model financesummary {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  full_name       String?   @db.VarChar(200)
  full_name_local String?   @db.VarChar(200)
  sex             sex_enum?
  ay_name         String?   @db.VarChar(100)
  ay_name_local   String?   @db.VarChar(100)
  total_fee       Decimal?  @db.Decimal(10, 2)
  total_expense   Decimal?  @db.Decimal(10, 2)
  net_balance     Decimal?  @db.Decimal(10, 2)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)
}

model leaverequest {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  academic_year_id String            @db.Uuid
  student_id       String?           @db.Uuid
  teacher_id       String?           @db.Uuid
  staff_id         String?           @db.Uuid
  start_date       DateTime?         @db.Date
  end_date         DateTime?         @db.Date
  note             String?
  status           leave_status_enum
  academicyear     academicyear      @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  student          student?          @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teacher          teacher?          @relation(fields: [teacher_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model libraryitem {
  id                  String            @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  branch_id           String            @db.Uuid
  registration_number String            @unique @db.VarChar(255)
  title               String            @db.VarChar(255)
  author              String            @db.VarChar(255)
  item_type           LibraryItemType
  subject             String            @db.VarChar(50)
  isbn                String?           @db.VarChar(50)
  copies_available    Int               @default(1) @db.Integer
  publication_date    DateTime          @db.Date
  parent_id           String?           @db.Uuid
  note                String?
  branch              branch            @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  //self relation
  parent              libraryitem?      @relation("LibraryItemHierarchy", fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  children            libraryitem[]     @relation("LibraryItemHierarchy")
  libraryItemLoan     libraryitemloan[]
}

model libraryitemloan {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  item_id     String       @db.Uuid
  student_id  String?      @db.Uuid
  teacher_id  String?      @db.Uuid
  issue_date  DateTime     @db.Date
  return_date DateTime     @db.Date
  status      BorrowStatus @default(BORROWED)
  note        String?
  libraryitem libraryitem  @relation(fields: [item_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  enrollment  enrollment?  @relation(fields: [student_id], references: [id], onUpdate: NoAction, onDelete: SetNull)
  teacher     teacher?     @relation(fields: [teacher_id], references: [id], onUpdate: NoAction, onDelete: SetNull)
  branch      branch?      @relation(fields: [branchId], references: [id])
  branchId    String?      @db.Uuid
}

model mark {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  student_id    String     @db.Uuid
  assessment_id String     @db.Uuid
  score         Decimal    @db.Decimal(5, 2)
  created_at    DateTime?  @default(now()) @db.Timestamp(6)
  updated_at    DateTime?  @default(now()) @db.Timestamp(6)
  assessment    assessment @relation(fields: [assessment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  enrollment    enrollment @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model school {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  name           String    @db.VarChar(255)
  address        String?
  contact        String?   @db.VarChar(100)
  note           String?
  better_auth_id String?   @db.VarChar(255)
  branch         branch[]
  setting        setting[]
}

model parent {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  branch_id        String          @db.Uuid
  better_auth_id   String          @db.VarChar(255)
  first_name       String          @db.VarChar(100)
  middle_name      String          @db.VarChar(100)
  phone            String          @db.VarChar(50)
  email            String          @db.VarChar(100)
  sex              sex_enum
  address          String
  note             String?
  studentRelations parentstudent[]
  branch           branch?         @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model staff {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  branch_id      String?         @db.Uuid
  better_auth_id String          @db.VarChar(255)
  first_name     String          @db.VarChar(100)
  middle_name    String          @db.VarChar(100)
  phone          String?         @db.VarChar(50)
  email          String          @db.VarChar(100)
  sex            sex_enum?
  role           staff_role_enum
  branch         branch?         @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model student {
  id                          String          @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  branch_id                   String          @db.Uuid
  better_auth_id              String          @db.VarChar(255)
  first_name                  String          @db.VarChar(100)
  middle_name                 String          @db.VarChar(100)
  last_name                   String          @db.VarChar(100)
  full_name_local             String          @db.VarChar(200)
  sex                         sex_enum
  dob                         DateTime        @db.Date
  address                     String
  email                       String          @db.VarChar(100)
  phone                       String          @db.VarChar(50)
  note                        String?
  image                       String?         @db.VarChar(255)
  student_registration_number Int             @default(autoincrement())
  enrollment                  enrollment[]
  parentRelations             parentstudent[]
  branch                      branch?         @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
  leaverequests               leaverequest[]
}

model teacher {
  id                          String            @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  better_auth_id              String            @db.VarChar(255)
  first_name                  String            @db.VarChar(100)
  middle_name                 String            @db.VarChar(100)
  phone                       String            @db.VarChar(50)
  email                       String            @db.VarChar(100)
  sex                         sex_enum
  subject_specialization      String            @db.VarChar(100)
  note                        String?
  image                       String?           @db.VarChar(255)
  teacher_registration_number Int               @default(autoincrement())
  branch_id                   String            @db.Uuid
  libraryItemLoan             libraryitemloan[]
  branch                      branch?           @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  timetable     timetable[]
  assessment    assessment[]
  leaverequests leaverequest[]
}

model studentmarksummary {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  full_name       String?   @db.VarChar(200)
  full_name_local String?   @db.VarChar(200)
  sex             sex_enum?
  ay_name         String?   @db.VarChar(100)
  ay_name_local   String?   @db.VarChar(100)
  subject         String?   @db.VarChar(100)
  total_score     Decimal?  @db.Decimal(10, 2)
  average_score   Decimal?  @db.Decimal(5, 2)
  created_at      DateTime? @default(now()) @db.Timestamp(6)
  updated_at      DateTime? @default(now()) @db.Timestamp(6)
}

model timetable {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  academic_year_id String    @db.Uuid
  term             String?   @db.VarChar(100)
  grade            Int       @db.Integer
  section          String    @db.VarChar(100)
  subject          String    @db.VarChar(100)
  teacher_id       String    @db.Uuid
  day              day_enum
  period           String    @db.VarChar(100)
  note             String?
  created_at       DateTime? @default(now()) @db.Timestamp(6)
  updated_at       DateTime? @default(now()) @db.Timestamp(6)
  teacher      teacher      @relation(fields: [teacher_id], references: [id], onUpdate: NoAction)
  academicyear academicyear @relation(fields: [academic_year_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model parentstudent {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  student_id String           @db.Uuid
  parent_id  String           @db.Uuid
  type       parent_type_enum
  student    student          @relation(fields: [student_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent     parent           @relation(fields: [parent_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model setting {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @map("_id") @db.Uuid
  school_id           String?   @db.Uuid
  number_of_terms     Int       @db.Integer
  sections_per_grade  Int       @db.Integer
  periods_per_day     Int       @default(1) @db.Integer
  levels_of_education String[]
  school              school?   @relation(fields: [school_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  created_at          DateTime? @default(now()) @db.Timestamp(6)
  updated_at          DateTime? @default(now()) @db.Timestamp(6)
}

model Dashboard {
  id   Int    @id @default(autoincrement())
  name String
}

enum attendance_status_enum {
  Present
  Absent
  Excused
}

enum behavior_type_enum {
  Positive
  Negative
}

enum day_enum {
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat
  Sun
}

enum fee_status_enum {
  Paid
  Unpaid
}

enum fee_type_enum {
  Tuition
  Exam
  Other
}

enum expense_type_enum {
  Salary
  Rent
  Other
}

enum sex_enum {
  Male
  Female
}

enum leave_status_enum {
  Pending
  Approved
  Rejected
}

enum parent_type_enum {
  Mother
  Father
  Brother
  Sister
  Aunt
  Uncle
  Guardian
  Other
}

enum staff_role_enum {
  Librarian
  Accountant
  Admin
}

enum LibraryItemType {
  book
  magazine
  journal
  e_book
  audio_book
  reference_book
  other
}

enum BorrowStatus {
  RETURNED
  BORROWED
  RESERVED
  OVERDUE
  LOST
  DAMAGED
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean
  image         String?
  createdAt     DateTime
  updatedAt     DateTime
  role          String?
  banned        Boolean?
  banReason     String?
  banExpires    DateTime?
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String
  createdAt      DateTime
  updatedAt      DateTime
  ipAddress      String?
  userAgent      String?
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  impersonatedBy String?

  @@unique([token])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime
  updatedAt             DateTime

  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime?
  updatedAt  DateTime?

  @@map("verification")
}
